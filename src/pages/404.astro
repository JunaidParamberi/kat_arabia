---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
	<section class="section">
		<div class="wrap" style="display:flex;flex-direction:column;gap:24px;padding-block:48px">
			<p class="disp" style="font-size:clamp(120px,22vw,240px);font-weight:300;line-height:.85;color:var(--maroon)">404</p>
			<h1 class="disp h-md">This plot is still bare ground.</h1>
			<p class="lead">The page you’re looking for doesn’t exist or has moved.</p>
			<div class="btn-row">
				<a href="/" class="btn btn--primary">Go home <span aria-hidden="true">→</span></a>
				<a href="/contact" class="btn btn--outline">Contact us</a>
			</div>
		</div>
	</section>
</Base>
