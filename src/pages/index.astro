---
import { getContentSeo, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import PageView from "../components/PageView.astro";
import { heroSeoDefaults, startsWithHero } from "../lib/page";
import { resolveSiteIdentity } from "../utils/site";

const [{ entry: page, cacheHint }, settings] = await Promise.all([
	getEmDashEntry("pages", "home"),
	getSiteSettings(),
]);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle, siteTagline } = resolveSiteIdentity(settings);
const blocks = (page?.data.content ?? []) as any[];
const seo = page
	? getSeoMeta(page, { siteUrl: Astro.url.origin, path: "/", ...heroSeoDefaults(blocks, Astro.url.origin) })
	: null;
const seoTitle = page ? getContentSeo(page)?.title || undefined : undefined;
---

<Base
	title={seoTitle}
	pageTitle={seoTitle}
	description={seo?.description}
	image={seo?.ogImage}
	canonical={seo?.canonical}
	robots={seo?.robots}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
	header={startsWithHero(blocks) ? "overlay" : "solid"}
>
	{
		page ? (
			<PageView page={page as any} />
		) : (
			<section class="section">
				<div class="wrap">
					<h1 class="disp h-xl">{siteTitle}</h1>
					{siteTagline && <p class="lead" style="margin-top:24px">{siteTagline}</p>}
					{Astro.locals.user && (
						<p class="lead" style="margin-top:24px">
							<a href="/_emdash/admin/content/pages/new">Create a page with the slug “home”</a> to show it here.
						</p>
					)}
				</div>
			</section>
		)
	}
</Base>
