---
import Eyebrow from "../Eyebrow.astro";
import { pad } from "../../lib/media";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const steps: Array<{ title: string; text?: string; icon?: string }> = v.steps ?? [];
const withIcons = v.style === "icons";

// Simple 24px stroke icons for the icon style.
const ICONS: Record<string, string> = {
	layers: "M12 3 3 8l9 5 9-5-9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5",
	flow: "M4 6h10m0 0-3-3m3 3-3 3M20 18H10m0 0 3-3m-3 3 3 3",
	globe: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm-9-9h18M12 3c2.5 2.5 3.8 5.5 3.8 9s-1.3 6.5-3.8 9c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z",
	bolt: "M13 2 4 14h7l-1 8 9-12h-7l1-8Z",
	compass: "M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm3.5-12.5-2 5-5 2 2-5 5-2Z",
	crane: "M4 21h10M7 21V5l9 0m-9 0 4-2 5 2v4m0 0v2m-4-6-5 5m14-1H7",
	shield: "M12 3 4 6v6c0 4.4 3.4 8 8 9 4.6-1 8-4.6 8-9V6l-8-3Zm-3 9 2 2 4-4",
	handshake: "m3 12 4-4 4 2 3-2 3 1 4 3-6 6-4-3-2 1-6-4Zm8-2 4 4",
};
const cols = v.columns === "3" ? 3 : 4;
const tone = v.tone === "night" ? "night" : v.tone === "sand" ? "sand" : "";
---

<section class:list={["section steps", tone, withIcons && "steps--icons"]} id={v.anchor_id || undefined}>
	<div class="wrap">
		<Eyebrow label={v.label} />
		<h2 class="disp steps__title" data-reveal>
			{v.headline}{v.highlight && <span class="accent"> {v.highlight}</span>}
		</h2>
		<ol class="steps__list" style={`--cols:${cols}`}>
			{
				steps.map((s, i) => (
					<li class="steps__item" data-reveal>
						{withIcons ? (
							<span class="steps__icon" aria-hidden="true">
								<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d={ICONS[s.icon ?? ""] ?? ICONS.layers} />
								</svg>
							</span>
						) : (
							<span class="disp steps__num">{pad(i + 1)}</span>
						)}
						<span class="disp steps__name">{s.title}</span>
						{s.text && <span class="steps__text">{s.text}</span>}
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps__title {
		max-width: 900px;
		margin-bottom: clamp(40px, 5vw, 64px);
		font-size: clamp(34px, 4vw, 60px);
	}
	.steps__list {
		display: grid;
		grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
		column-gap: 32px;
		row-gap: 56px;
	}
	.steps__item {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-top: 22px;
		border-top: 1px solid currentColor;
	}
	.steps__num {
		font-size: clamp(52px, 5vw, 72px);
		font-weight: 300;
		line-height: 0.9;
		color: var(--maroon);
	}
	.night .steps__num {
		color: var(--gold);
	}
	.steps__name {
		font-size: 26px;
		line-height: 1.1;
		letter-spacing: -0.02em;
	}
	.steps__text {
		font-size: 15px;
		line-height: 1.6;
		color: var(--ink-muted);
	}
	.night .steps__text {
		color: var(--on-night-muted);
	}
	/* icon style */
	.steps--icons .steps__list {
		row-gap: 40px;
	}
	.steps--icons .steps__item {
		padding-top: 0;
		border-top: 0;
	}
	.steps__icon {
		border-radius: 14px;
		display: grid;
		place-items: center;
		width: 52px;
		height: 52px;
		background: var(--maroon);
		color: #fff;
	}
	.night .steps__icon {
		background: rgba(227, 184, 119, 0.14);
		color: var(--gold);
	}
	.steps--icons .steps__name {
		font-size: 20px;
		line-height: 1.25;
		font-weight: 700;
	}
	@media (max-width: 960px) {
		.steps__list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.steps__list {
			grid-template-columns: 1fr;
			row-gap: 36px;
		}
		.steps--icons .steps__list {
			grid-template-columns: 1fr 1fr;
			column-gap: 16px;
			row-gap: 28px;
		}
		.steps--icons .steps__item {
			gap: 10px;
		}
		.steps--icons .steps__icon {
			width: 40px;
			height: 40px;
			border-radius: 12px;
		}
		.steps--icons .steps__name {
			font-size: 15px;
		}
		.steps--icons .steps__text {
			font-size: 13px;
			line-height: 1.45;
		}
	}
</style>
