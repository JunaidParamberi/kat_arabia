---
import { mediaUrl } from "../../lib/media";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const logos: Array<{ name: string; logo?: any }> = v.logos ?? [];
---

<section class="section clients" id={v.anchor_id || undefined}>
	<div class="wrap">
		{v.label && <div class="sec-label mono"><span>{v.label}</span><span>KAT Group clients</span></div>}
		<h2 class="disp clients__title" data-reveal>{v.headline}</h2>
		<ul class="clients__grid">
			{
				logos.map((l) => {
					const src = mediaUrl(l.logo);
					return (
						<li class="clients__cell">
							{src ? <img src={src} alt={l.name} loading="lazy" /> : <span class="mono">{l.name}</span>}
						</li>
					);
				})
			}
		</ul>
		<p class="clients__note">Logos shown in monochrome; full colour on hover.</p>
	</div>
</section>

<style>
	.clients {
		padding-top: 0;
	}
	.clients__title {
		margin-bottom: 48px;
		font-size: clamp(32px, 3.2vw, 44px);
	}
	.clients__grid {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		border-top: 1px solid var(--rule);
		border-left: 1px solid var(--rule);
	}
	.clients__cell {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 110px;
		padding: 20px;
		border-right: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		color: #6b6056;
	}
	.clients__cell img {
		max-height: 44px;
		width: auto;
		filter: grayscale(1);
		opacity: 0.75;
		transition:
			filter 0.3s,
			opacity 0.3s;
	}
	.clients__cell:hover img {
		filter: none;
		opacity: 1;
	}
	.clients__note {
		margin-top: 16px;
		font-size: 13px;
		color: var(--ink-muted);
	}
	@media (max-width: 860px) {
		.clients__grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
