---
import { pickImage } from "../../lib/media";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const bg = pickImage(v.image, v.default_image && v.default_image !== "none" ? v.default_image : null);
---

<section class:list={["cta", bg && "cta--photo"]} id={v.anchor_id || undefined}>
	<div class="cta__panel">
	{bg && <img class="cta__bg" src={bg.src} alt="" loading="lazy" />}
	<div class="wrap cta__inner">
		<h2 class="disp cta__title" data-reveal>{v.headline}</h2>
		<div class="btn-row">
			{
				v.primary_cta_label && (
					<a href={v.primary_cta_url || "/contact"} class="btn btn--light">
						{v.primary_cta_label} <span aria-hidden="true">→</span>
					</a>
				)
			}
			{
				v.secondary_cta_label && (
					<a href={v.secondary_cta_url || "/contact"} class="btn btn--ghost">
						{v.secondary_cta_label}
					</a>
				)
			}
		</div>
	</div>
	</div>
</section>

<style>
	.cta {
		padding-block: clamp(64px, 7vw, 88px);
		background: var(--maroon);
		color: #fff;
	}
	.cta__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
	}
	.cta__title {
		max-width: 760px;
		font-size: clamp(34px, 4vw, 56px);
		line-height: 1;
	}
	/* photo variant: a full-width photo band */
	.cta--photo {
		padding-block: 0;
		background: var(--ink);
	}
	.cta--photo .cta__panel {
		position: relative;
		padding-block: clamp(96px, 12vw, 168px);
		background: var(--ink-2);
	}
	.cta__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.cta--photo .cta__panel::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		background: linear-gradient(90deg, rgba(12, 9, 8, 0.9) 0%, rgba(12, 9, 8, 0.6) 55%, rgba(12, 9, 8, 0.35) 100%);
	}
	.cta--photo .cta__inner {
		position: relative;
		z-index: 2;
	}
	.cta--photo .cta__title {
		font-size: clamp(36px, 5vw, 72px);
	}
	.cta .btn--ghost {
		border-color: rgba(255, 255, 255, 0.6);
	}
</style>
