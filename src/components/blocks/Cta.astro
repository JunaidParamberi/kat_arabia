---
interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
---

<section class="cta" id={v.anchor_id || undefined}>
	<div class="wrap cta__inner">
		<h2 class="disp cta__title" data-reveal>{v.headline}</h2>
		<div class="btn-row">
			{
				v.primary_cta_label && (
					<a href={v.primary_cta_url || "/contact"} class="btn btn--light">
						{v.primary_cta_label} <span aria-hidden="true">→</span>
					</a>
				)
			}
			{
				v.secondary_cta_label && (
					<a href={v.secondary_cta_url || "/contact"} class="btn btn--ghost">
						{v.secondary_cta_label}
					</a>
				)
			}
		</div>
	</div>
</section>

<style>
	.cta {
		padding-block: clamp(64px, 7vw, 88px);
		background: var(--maroon);
		color: #fff;
	}
	.cta__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 32px;
	}
	.cta__title {
		max-width: 760px;
		font-size: clamp(34px, 4vw, 56px);
		line-height: 1;
	}
	.cta .btn--ghost {
		border-color: rgba(255, 255, 255, 0.6);
	}
</style>
