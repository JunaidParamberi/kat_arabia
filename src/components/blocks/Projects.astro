---
import { getProjects } from "../../lib/content";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const projects = await getProjects();
---

<section class="section projects" id={v.anchor_id || undefined}>
	<div class="wrap">
		{
			v.label && (
				<div class="sec-label mono">
					<span>{v.label}</span>
					<span>{projects.length} {projects.length === 1 ? "profile" : "profiles"}</span>
				</div>
			)
		}
		<div class="sec-head">
			<h2 class="disp h-lg" data-reveal>
				{v.headline}
				{v.highlight && <span class="accent"> {v.highlight}</span>}
			</h2>
			{v.intro && <p class="lead" data-reveal>{v.intro}</p>}
		</div>
		{
			projects.length > 0 && (
				<ul class="projects__grid">
					{projects.map((p, i) => (
						<li class="projects__card" data-reveal>
							{p.image && (
								<figure class="projects__figure">
									<img src={p.image.src} alt={p.image.alt} loading="lazy" />
									<figcaption class="mono">{String(i + 1).padStart(2, "0")}</figcaption>
								</figure>
							)}
							<h3 class="disp projects__title">{p.title}</h3>
							{p.summary && <p class="projects__summary">{p.summary}</p>}
						</li>
					))}
				</ul>
			)
		}
		{
			v.cta_label && v.cta_url && (
				<p class="projects__cta">
					<a class="btn btn--ink" href={v.cta_url}>
						{v.cta_label}
					</a>
				</p>
			)
		}
	</div>
</section>

<style>
	.projects__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 40px 32px;
		margin-top: 56px;
	}
	.projects__card {
		display: flex;
		flex-direction: column;
	}
	.projects__figure {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #2a1c17;
		margin-bottom: 20px;
	}
	.projects__figure img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1.02);
		transition: transform 0.8s var(--ease);
	}
	.projects__card:hover .projects__figure img {
		transform: scale(1.06);
	}
	.projects__figure figcaption {
		position: absolute;
		inset-inline-start: 0;
		bottom: 0;
		padding: 10px 14px;
		background: rgba(11, 8, 7, 0.72);
		color: #f6f0e6;
	}
	.projects__title {
		font-size: clamp(22px, 1.9vw, 28px);
		line-height: 1.15;
		margin-bottom: 10px;
	}
	.projects__summary {
		font-size: 15px;
		line-height: 1.55;
		color: var(--ink-muted);
	}
	.projects__cta {
		margin-top: 48px;
	}
	@media (max-width: 960px) {
		.projects__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 560px) {
		.projects__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
