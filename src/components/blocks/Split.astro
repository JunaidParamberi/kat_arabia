---
import { paragraphs, pickImage } from "../../lib/media";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const img = pickImage(v.image, v.default_image || "steel-erection");
const body = paragraphs(v.body);
const facts: Array<{ value: string; label: string }> = v.facts ?? [];
---

<section class:list={["split night", { "split--right": v.image_right }]} id={v.anchor_id || undefined}>
	<div class="split__media">
		{img && <img src={img.src} alt={img.alt} loading="lazy" data-parallax />}
	</div>
	<div class="split__copy">
		{v.label && <div class="mono split__label">{v.label}</div>}
		<h2 class="disp split__title" data-reveal>
			{v.headline}{v.highlight && <span class="accent"> {v.highlight}</span>}
		</h2>
		{body.map((p) => <p class="split__body" data-reveal>{p}</p>)}
		{
			facts.length > 0 && (
				<dl class="split__facts">
					{facts.map((f, i) => (
						<div>
							<dt>{f.label}</dt>
							<dd class:list={["disp", { accent: i === facts.length - 1 }]} data-count={f.value}>
								{f.value}
							</dd>
						</div>
					))}
				</dl>
			)
		}
		{
			v.cta_label && (
				<div class="btn-row">
					<a href={v.cta_url || "/contact"} class="btn btn--primary">
						{v.cta_label} <span aria-hidden="true">→</span>
					</a>
				</div>
			)
		}
	</div>
</section>

<style>
	.split {
		display: grid;
		grid-template-columns: 1fr 1fr;
		min-height: 640px;
	}
	.split--right .split__media {
		order: 2;
	}
	.split__media {
		position: relative;
		overflow: hidden;
		min-height: 420px;
	}
	.split__media img {
		position: absolute;
		inset: -6% 0;
		width: 100%;
		height: 112%;
		object-fit: cover;
	}
	.split__copy {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 26px;
		padding: clamp(64px, 8vw, 104px) var(--gutter);
		max-width: 720px;
	}
	.split__label {
		color: var(--gold);
	}
	.split__title {
		font-size: clamp(34px, 3.8vw, 56px);
		line-height: 1;
	}
	.split__body {
		max-width: 500px;
		color: var(--on-night-muted);
	}
	.split__facts {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-top: 1px solid var(--rule-dark);
	}
	.split__facts > div {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		padding: 20px 0;
	}
	.split__facts > div:nth-child(even) {
		padding-left: 24px;
		border-left: 1px solid var(--rule-dark);
	}
	.split__facts > div:nth-child(n + 3) {
		border-top: 1px solid var(--rule-dark);
	}
	.split__facts dt {
		font-size: 14px;
		color: var(--on-night-dim);
	}
	.split__facts dd {
		font-size: 56px;
		font-weight: 300;
		line-height: 0.9;
	}
	@media (max-width: 860px) {
		.split {
			grid-template-columns: 1fr;
		}
		.split--right .split__media {
			order: 0;
		}
		.split__media {
			min-height: 340px;
		}
	}
</style>
