---
import Eyebrow from "../Eyebrow.astro";
import { getIndustries } from "../../lib/content";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
// One tile per unique title, so stale duplicate entries never show twice.
const seen = new Set<string>();
const items = (await getIndustries()).filter((it) => {
	const key = it.title.trim().toLowerCase();
	if (!key || seen.has(key)) return false;
	seen.add(key);
	return true;
});
---

{
	items.length > 0 && (
		<section class="section industries" id={v.anchor_id || undefined}>
			<div class="wrap">
				<Eyebrow label={v.label} />
				<div class="sec-head">
					<h2 class="disp h-lg" data-reveal>
						{v.headline}
						{v.highlight && <span class="accent"> {v.highlight}</span>}
					</h2>
					{v.intro && (
						<p class="lead" data-reveal>
							{v.intro}
						</p>
					)}
				</div>
				<ul class="industries__bento">
					{items.map((it, i) => (
						<li class:list={["industries__tile", { "industries__tile--plain": !it.image }]} data-reveal>
							{it.image && <img src={it.image.src} alt="" loading="lazy" />}
							<span class="industries__num">{String(i + 1).padStart(2, "0")}</span>
							<span class="industries__name">
								{it.title}
								<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
									<path d="M4 12 12 4M6 4h6v6" />
								</svg>
							</span>
						</li>
					))}
				</ul>
			</div>
		</section>
	)
}

<style>
	/* Bento mosaic: 12 columns, two feature tiles (1st and 8th) span half the width and two rows. */
	.industries__bento {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-auto-rows: clamp(170px, 15vw, 230px);
		grid-auto-flow: dense;
		gap: 12px;
	}
	.industries__tile {
		position: relative;
		grid-column: span 3;
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		border-radius: var(--r-lg);
		background: var(--ink);
		color: #fff;
	}
	.industries__tile:nth-child(1),
	.industries__tile:nth-child(8) {
		grid-column: span 6;
		grid-row: span 2;
	}
	.industries__tile img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1s var(--ease);
	}
	.industries__tile::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(12, 9, 8, 0) 50%, rgba(12, 9, 8, 0.55) 100%);
	}
	.industries__tile:hover img {
		transform: scale(1.07);
	}
	.industries__tile--plain {
		background: var(--maroon);
	}
	.industries__num {
		position: absolute;
		top: 14px;
		left: 14px;
		z-index: 1;
		padding: 5px 10px;
		border-radius: 999px;
		background: rgba(12, 9, 8, 0.35);
		backdrop-filter: blur(10px);
		-webkit-backdrop-filter: blur(10px);
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.08em;
	}
	.industries__name {
		position: relative;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin: 14px;
		padding: 10px 16px;
		border-radius: 999px;
		background: rgba(246, 240, 230, 0.16);
		border: 1px solid rgba(246, 240, 230, 0.22);
		backdrop-filter: blur(14px) saturate(1.3);
		-webkit-backdrop-filter: blur(14px) saturate(1.3);
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 14px;
		line-height: 1.2;
	}
	.industries__name svg {
		flex-shrink: 0;
		transition: transform 0.4s var(--ease);
	}
	.industries__tile:hover .industries__name svg {
		transform: translate(2px, -2px);
	}
	.industries__tile:nth-child(1) .industries__name,
	.industries__tile:nth-child(8) .industries__name {
		padding: 14px 22px;
		font-size: clamp(16px, 1.5vw, 22px);
	}
	@media (max-width: 1100px) {
		.industries__bento {
			grid-template-columns: repeat(6, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.industries__bento {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			grid-auto-rows: 128px;
			gap: 8px;
		}
		.industries__tile,
		.industries__tile:nth-child(1),
		.industries__tile:nth-child(8) {
			grid-column: span 1;
			grid-row: span 1;
		}
		.industries__tile:nth-child(1),
		.industries__tile:nth-child(8) {
			grid-column: span 2;
			grid-row: span 1;
		}
		.industries__num {
			display: none;
		}
		.industries__name,
		.industries__tile:nth-child(1) .industries__name,
		.industries__tile:nth-child(8) .industries__name {
			margin: 8px;
			padding: 6px 10px;
			font-size: 12px;
		}
		.industries__name svg {
			display: none;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.industries__tile img,
		.industries__name svg {
			transition: none;
		}
	}
</style>
