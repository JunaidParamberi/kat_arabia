---
import { getIndustries } from "../../lib/content";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const items = await getIndustries();
const withImage = items.filter((i) => i.image);
const startIndex = Math.max(
	0,
	items.findIndex((i) => i.image),
);
---

<section class="section industries" id={v.anchor_id || undefined} data-industries>
	<div class="wrap">
		{v.label && <div class="sec-label mono"><span>{v.label}</span><span>{items.length} sectors</span></div>}
		<div class="sec-head">
			<h2 class="disp h-lg" data-reveal>
				{v.headline}{v.highlight && <span class="accent"> {v.highlight}</span>}
			</h2>
			{v.intro && <p class="lead" data-reveal>{v.intro}</p>}
		</div>
		<div class="industries__grid">
			<ol class="industries__list">
				{
					items.map((it, i) => (
						<li>
							<button
								type="button"
								class:list={["industries__item", { "is-active": i === startIndex }]}
								data-ind={i}
								data-has-image={it.image ? "true" : "false"}
							>
								<span class="mono industries__num">{it.number}</span>
								<span class="disp">{it.title}</span>
							</button>
						</li>
					))
				}
			</ol>
			{
				withImage.length > 0 && (
					<figure class="industries__figure" aria-live="polite">
						{items.map((it, i) =>
							it.image ? (
								<img
									class:list={{ "is-active": i === startIndex }}
									src={it.image.src}
									alt={it.image.alt}
									loading="lazy"
									data-ind-img={i}
								/>
							) : null,
						)}
						<figcaption>
							<span class="disp" data-ind-title>
								{items[startIndex]?.title}
							</span>
							<span class="mono" data-ind-count>
								{items[startIndex]?.number} / {String(items.length).padStart(2, "0")}
							</span>
						</figcaption>
					</figure>
				)
			}
		</div>
	</div>
</section>

<style>
	.industries__grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: 24px;
		align-items: start;
	}
	.industries__list {
		grid-column: span 8;
		display: grid;
		grid-template-columns: 1fr 1fr;
		grid-auto-flow: column;
		grid-template-rows: repeat(7, auto);
		column-gap: 32px;
		border-bottom: 1px solid var(--rule);
	}
	.industries__item {
		display: grid;
		grid-template-columns: 44px minmax(0, 1fr);
		align-items: baseline;
		gap: 12px;
		width: 100%;
		min-height: 64px;
		padding: 16px 0;
		background: none;
		border: 0;
		border-top: 1px solid var(--rule);
		color: #2a2220;
		font-size: clamp(20px, 1.9vw, 26px);
		text-align: left;
		cursor: default;
		transition: color 0.2s;
	}
	.industries__item[data-has-image="true"] {
		cursor: pointer;
	}
	.industries__item:hover,
	.industries__item.is-active {
		color: var(--maroon);
	}
	.industries__item.is-active {
		border-top: 2px solid var(--maroon);
	}
	.industries__num {
		color: var(--maroon);
	}
	.industries__figure {
		grid-column: 9 / span 4;
		position: sticky;
		top: 96px;
		aspect-ratio: 3 / 4;
		overflow: hidden;
		background: #2a1c17;
	}
	.industries__figure img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0;
		transform: scale(1.04);
		transition:
			opacity 0.6s var(--ease),
			transform 1.2s var(--ease);
	}
	.industries__figure img.is-active {
		opacity: 1;
		transform: none;
	}
	.industries__figure figcaption {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 18px;
		background: linear-gradient(180deg, transparent, rgba(11, 8, 7, 0.75));
		color: #f6f0e6;
	}
	.industries__figure figcaption .disp {
		font-size: 24px;
	}
	@media (max-width: 960px) {
		.industries__list {
			grid-column: 1 / -1;
		}
		.industries__figure {
			display: none;
		}
	}
	@media (max-width: 560px) {
		.industries__list {
			grid-template-columns: 1fr;
			grid-auto-flow: row;
			grid-template-rows: none;
		}
	}
</style>
