---
import { mediaUrl, pad, pickImage } from "../../lib/media";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const chapters: Array<{ title: string; description?: string; services?: string }> = v.chapters ?? [];
const uploadedVideo = mediaUrl(v.video);
const videoSrc = uploadedVideo || "/film/film-scrub.mp4";
const uploadedPoster = pickImage(v.poster);
const poster = uploadedPoster ?? { src: "/film/film-poster.webp", alt: "Construction time-lapse of a tower rising from bare ground to a finished skyline" };
const total = pad(chapters.length);
---

<section
	class="film on-image"
	id={v.anchor_id || "film"}
	aria-labelledby="film-title"
	data-film
	data-chapters={chapters.length}
>
	<div class="film__stage" data-film-stage>
		{
			videoSrc ? (
				<video
					class="film__media"
					src={uploadedVideo ? videoSrc : undefined}
					poster={poster?.src}
					muted
					playsinline
					preload="auto"
					aria-hidden="true"
					data-film-video
				>
					{!uploadedVideo && (
						<>
							<source src="/film/film-scrub-mobile.mp4" type="video/mp4" media="(max-width: 768px)" />
							<source src="/film/film-scrub.mp4" type="video/mp4" media="(min-width: 769px)" />
						</>
					)}
				</video>
			) : (
				poster && (
					<img class="film__media" src={poster.src} alt={poster.alt} loading="lazy" data-film-poster />
				)
			)
		}
		<div class="film__scrim" aria-hidden="true"></div>
		<div class="film__grade" aria-hidden="true"></div>
		<div class="film__grain" aria-hidden="true"></div>

		<div class="film__top wrap" data-film-intro>
			<div class="film__intro">
				{v.label && <div class="mono film__label">{v.label}</div>}
				<h2 id="film-title" class="disp film__title">{v.headline}</h2>
				{v.intro && <p class="film__lead">{v.intro}</p>}
			</div>
			<div class="mono film__counter" aria-hidden="true">
				Chapter <span data-film-num>01</span> / {total}
			</div>
		</div>

		<div class="film__caption-wrap wrap">
			<div class="film__caption" aria-live="polite">
				{
					chapters.map((c, i) => (
						<div class:list={["film__chapter", { "is-active": i === 0 }]} data-film-chapter={i}>
							<div class="mono film__chapter-num">Chapter {pad(i + 1)} / {total}</div>
							<div class="disp film__chapter-title">{c.title}</div>
							{c.description && <p>{c.description}</p>}
							{c.services && <p class="mono film__services">{c.services}</p>}
						</div>
					))
				}
			</div>
		</div>

		<div class="film__bar">
			<div class="wrap film__tabs" role="tablist" aria-label="Film chapters">
				{
					chapters.map((c, i) => (
						<button
							type="button"
							role="tab"
							class:list={["film__tab mono", { "is-active": i === 0 }]}
							aria-selected={i === 0 ? "true" : "false"}
							data-film-tab={i}
						>
							<span class="film__track" aria-hidden="true">
								<span class="film__fill" data-film-fill={i} />
							</span>
							<span>
								{pad(i + 1)}<span class="film__tab-name">  {c.title}</span>
							</span>
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.film {
		position: relative;
		background: #140e0d;
		color: #f6f0e6;
	}
	.film__stage {
		position: relative;
		height: 100svh;
		min-height: 640px;
		overflow: hidden;
	}
	.film__media {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.film__scrim {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(0deg, rgba(8, 5, 4, 0.5) 0%, rgba(8, 5, 4, 0) 32%),
			radial-gradient(130% 95% at 50% 50%, rgba(8, 5, 4, 0) 50%, rgba(8, 5, 4, 0.42) 100%);
	}
	.film__grade {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: #1c1109;
		mix-blend-mode: multiply;
		opacity: 0.22;
		pointer-events: none;
	}
	.film__grain {
		position: absolute;
		inset: 0;
		z-index: 1;
		opacity: 0.05;
		mix-blend-mode: overlay;
		pointer-events: none;
		background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
		background-size: 180px 180px;
	}
	.film__top {
		position: absolute;
		inset: 0 0 auto 0;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		gap: 32px;
		padding-top: 48px;
		transition:
			opacity 0.6s var(--ease),
			filter 0.6s var(--ease),
			transform 0.6s var(--ease);
	}
	.film__intro {
		display: flex;
		flex-direction: column;
		gap: 16px;
		max-width: 620px;
	}
	.film__label {
		color: #fff;
		mix-blend-mode: difference;
	}
	.film__title {
		color: #fff;
		mix-blend-mode: difference;
		font-size: clamp(36px, 4.6vw, 66px);
	}
	.film__lead {
		max-width: 460px;
		color: #fff;
		mix-blend-mode: difference;
	}
	.film__counter {
		color: #fff;
		mix-blend-mode: difference;
		white-space: nowrap;
	}
	.film__caption-wrap {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 64px;
		z-index: 2;
		pointer-events: none;
	}
	.film__caption {
		position: relative;
		width: min(420px, 100%);
		min-height: 120px;
		pointer-events: auto;
	}
	.film__chapter {
		position: absolute;
		inset: auto 0 0 0;
		display: flex;
		flex-direction: column;
		gap: 8px;
		opacity: 0;
		filter: blur(6px);
		transform: translateY(14px);
		transition:
			opacity 0.9s var(--ease),
			filter 0.9s var(--ease),
			transform 0.9s var(--ease);
	}
	.film__chapter.is-active {
		opacity: 1;
		filter: blur(0);
		transform: none;
	}
	/* Quiet, small caption so the footage carries the section. */
	.film__chapter-num {
		color: rgba(255, 255, 255, 0.6);
		font-size: 10px;
		letter-spacing: 0.3em;
	}
	.film__chapter-title {
		color: #fff;
		font-size: clamp(20px, 1.8vw, 26px);
		font-weight: 600;
		letter-spacing: -0.01em;
		line-height: 1.1;
		text-shadow: 0 1px 12px rgba(0, 0, 0, 0.35);
	}
	.film__chapter p {
		color: rgba(255, 255, 255, 0.78);
		font-size: 13px;
		line-height: 1.5;
		max-width: 340px;
		text-shadow: 0 1px 10px rgba(0, 0, 0, 0.4);
	}
	.film__chapter .film__services {
		font-size: 10px;
		letter-spacing: 0.18em;
		color: #fff;
		mix-blend-mode: difference;
		line-height: 1.7;
		opacity: 0.85;
	}
	.film__bar {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 3;
	}
	.film__tabs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
		grid-auto-flow: column;
		gap: 6px;
		padding-block: 0 22px;
	}
	.film__tab {
		display: flex;
		flex-direction: column;
		gap: 8px;
		min-height: 32px;
		padding: 0;
		background: none;
		border: 0;
		font-size: 9px;
		color: rgba(246, 240, 230, 0.4);
		text-align: left;
		cursor: pointer;
	}
	.film__tab.is-active,
	.film__tab:hover {
		color: #f6f0e6;
	}
	.film__track {
		display: block;
		height: 1px;
		background: rgba(246, 240, 230, 0.18);
	}
	.film__fill {
		display: block;
		height: 1px;
		width: 0;
		background: #f6f0e6;
	}
	.film__tab.is-active .film__fill {
		width: 100%;
	}
	.js .film__tab .film__fill {
		width: 0;
	}
	@media (max-width: 760px) {
		.film__top {
			flex-direction: column;
			padding-top: 40px;
		}
		.film__counter,
		.film__lead {
			display: none;
		}
		.film__caption-wrap {
			bottom: 96px;
		}
		.film__tab-name {
			display: none;
		}
	}
</style>
