---
import { getServices } from "../../lib/content";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
const services = await getServices();
const isGrid = v.layout === "grid";
const start = Math.min(2, Math.max(0, services.length - 1));
---

<section class:list={["section caps", { sand: !isGrid }]} id={v.anchor_id || undefined}>
	<div class="wrap">
		{v.label && <div class="sec-label mono"><span>{v.label}</span><span>{services.length} service lines · 1 QHSE system</span></div>}
		<div class="sec-head">
			<h2 class="disp h-lg" data-reveal>
				{v.headline}{v.highlight && <span class="accent"> {v.highlight}</span>}
			</h2>
			{v.intro && <p class="lead" data-reveal>{v.intro}</p>}
		</div>

		{
			isGrid ? (
				<div class="caps__grid">
					{services.map((s) => (
						<article class="caps__card" data-reveal>
							<a href={`/services/${s.slug}`} class="caps__card-media" aria-hidden="true" tabindex="-1">
								{s.image ? (
									<img src={s.image.src} alt="" loading="lazy" />
								) : (
									<span class="mono caps__ph">[ Image: {s.title} ]</span>
								)}
								<span class="disp caps__card-num">{s.number}</span>
							</a>
							<h3 class="disp caps__card-title">
								<a href={`/services/${s.slug}`}>{s.title}</a>
							</h3>
							<p class="caps__card-text">{s.summary}</p>
							<ul class="caps__scope caps__scope--2">
								{s.scope.map((x) => <li>{x}</li>)}
							</ul>
							<a href={`/services/${s.slug}`} class="caps__more">
								View service <span aria-hidden="true">→</span>
							</a>
						</article>
					))}
				</div>
			) : (
				<div class="caps__tabs" data-caps>
					<div class="caps__list" role="tablist" aria-label="Capabilities">
						{services.map((s, i) => (
							<div class:list={["caps__row", { "is-active": i === start }]} data-caps-row={i}>
								<button
									type="button"
									role="tab"
									id={`cap-tab-${i}`}
									aria-controls={`cap-panel-${i}`}
									aria-selected={i === start ? "true" : "false"}
									class="caps__btn"
									data-caps-tab={i}
								>
									<span class="mono caps__num">{s.number}</span>
									<span class="disp caps__name">{s.title}</span>
									<span class="caps__sign" aria-hidden="true" />
								</button>
								<p class="caps__desc">{s.summary}</p>
							</div>
						))}
					</div>
					<div class="caps__panels">
						{services.map((s, i) => (
							<div
								class:list={["caps__panel", { "is-active": i === start }]}
								role="tabpanel"
								id={`cap-panel-${i}`}
								aria-labelledby={`cap-tab-${i}`}
								hidden={i !== start}
								data-caps-panel={i}
							>
								<figure class="caps__media">
									{s.image ? (
										<img src={s.image.src} alt={s.image.alt} loading="lazy" />
									) : (
										<span class="mono caps__ph">[ Image: {s.title} ]</span>
									)}
									<figcaption class="mono">
										{s.number} · {s.title}
									</figcaption>
								</figure>
								<div class="mono caps__scope-label">Typical scope</div>
								<ul class="caps__scope caps__scope--2">
									{s.scope.map((x) => <li>{x}</li>)}
								</ul>
								<div class="btn-row">
									<a href={`/services/${s.slug}`} class="btn btn--ink">
										View service <span aria-hidden="true">→</span>
									</a>
									{v.cta_label && (
										<a href={v.cta_url || "/contact"} class="btn btn--outline">
											{v.cta_label}
										</a>
									)}
								</div>
							</div>
						))}
					</div>
				</div>
			)
		}
	</div>
</section>

<style>
	/* tabs */
	.caps__tabs {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: 24px;
		align-items: start;
	}
	.caps__list {
		grid-column: span 6;
		border-bottom: 1px solid var(--rule);
	}
	.caps__row {
		border-top: 1px solid var(--rule);
	}
	.caps__row.is-active {
		border-top: 2px solid var(--maroon);
		padding-bottom: 22px;
	}
	.caps__btn {
		display: grid;
		grid-template-columns: 56px minmax(0, 1fr) 28px;
		align-items: center;
		gap: 16px;
		width: 100%;
		min-height: 68px;
		padding: 0;
		background: none;
		border: 0;
		color: var(--ink-muted);
		text-align: left;
		cursor: pointer;
	}
	.caps__btn:hover,
	.is-active .caps__btn {
		color: var(--ink);
	}
	.caps__num {
		color: var(--maroon);
	}
	.caps__name {
		font-size: clamp(20px, 1.9vw, 26px);
		line-height: 1.15;
		letter-spacing: -0.02em;
	}
	.caps__sign {
		position: relative;
		width: 14px;
		height: 14px;
	}
	.caps__sign::before,
	.caps__sign::after {
		content: "";
		position: absolute;
		left: 0;
		top: 6px;
		width: 14px;
		height: 1.5px;
		background: currentColor;
		transition: transform 0.3s var(--ease);
	}
	.caps__sign::after {
		transform: rotate(90deg);
	}
	.is-active .caps__sign::after {
		transform: rotate(0);
	}
	.caps__desc {
		display: none;
		margin: 0 44px 0 72px;
		font-size: 15px;
		color: var(--ink-soft);
	}
	.is-active .caps__desc {
		display: block;
	}
	.caps__panels {
		grid-column: 8 / span 5;
		position: sticky;
		top: 96px;
	}
	.caps__panel {
		display: flex;
		flex-direction: column;
		gap: 24px;
	}
	.caps__panel[hidden] {
		display: none;
	}
	.caps__media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		background: #2a1f1b;
	}
	.caps__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.caps__media figcaption {
		position: absolute;
		left: 16px;
		bottom: 14px;
		color: #f6f0e6;
		font-size: 10px;
		text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6);
	}
	.caps__ph {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--on-night-dim);
	}
	.caps__scope-label {
		color: var(--ink-muted);
		margin-bottom: -14px;
	}
	.caps__scope--2 {
		display: grid;
		grid-template-columns: 1fr 1fr;
		column-gap: 24px;
	}
	.caps__scope li {
		padding: 12px 0;
		border-top: 1px solid #bfb29d;
		font-size: 15px;
	}

	/* grid */
	.caps__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 72px 32px;
	}
	.caps__card {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}
	.caps__card-media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		background: #2a1f1b;
	}
	.caps__card-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.8s var(--ease);
	}
	.caps__card:hover .caps__card-media img {
		transform: scale(1.04);
	}
	.caps__card-num {
		position: absolute;
		left: 20px;
		bottom: 12px;
		font-size: 64px;
		font-weight: 300;
		color: #f6f0e6;
		line-height: 1;
	}
	.caps__card-title {
		font-size: clamp(26px, 2.4vw, 34px);
		line-height: 1.05;
	}
	.caps__card-text {
		max-width: 560px;
		color: var(--ink-soft);
	}
	.caps__more {
		align-self: flex-start;
		display: inline-flex;
		gap: 10px;
		min-height: 44px;
		align-items: center;
		font-weight: 600;
		color: var(--maroon);
	}

	@media (max-width: 960px) {
		.caps__list,
		.caps__panels {
			grid-column: 1 / -1;
		}
		.caps__panels {
			position: static;
			margin-top: 40px;
		}
		.caps__grid {
			grid-template-columns: 1fr;
			gap: 56px;
		}
	}
</style>
