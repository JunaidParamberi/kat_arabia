---
import Eyebrow from "../Eyebrow.astro";
import MAP from "../../data/gulf-map.json";

interface Props {
	value: Record<string, any>;
}
const { value: v } = Astro.props;
type Office = { city: string; country?: string; role?: string; address?: string; phone?: string; primary?: boolean };
const offices: Office[] = v.offices ?? [];

// The map is a survey plate: real Natural Earth coastlines projected by scripts/build-maps.mjs,
// with each office set out as a numbered benchmark.
const GEO: Record<string, { lat: number; lon: number }> = {
	"abu dhabi": { lat: 24.45, lon: 54.37 },
	dubai: { lat: 25.2, lon: 55.27 },
	sharjah: { lat: 25.35, lon: 55.41 },
	"al jubail": { lat: 27.01, lon: 49.66 },
	jubail: { lat: 27.01, lon: 49.66 },
	riyadh: { lat: 24.71, lon: 46.72 },
	dammam: { lat: 26.43, lon: 50.1 },
};
// Which side of its benchmark each label sits, so the close UAE cities don't collide.
const PLACE: Record<string, "e" | "w" | "n" | "s"> = { "abu dhabi": "s", dubai: "w", sharjah: "n" };
const key = (city: string) => city.trim().toLowerCase();

const marks = offices
	.map((o, i) => ({
		...o,
		i,
		no: `BM-${String(i + 1).padStart(2, "0")}`,
		pos: (MAP.cities as Record<string, [number, number]>)[key(o.city)],
		geo: GEO[key(o.city)],
		place: PLACE[key(o.city)] ?? "e",
	}))
	.filter((m) => m.pos);
const hub = marks.find((m) => m.primary) ?? marks[0];

// Great-circle distance in km, as the crow flies.
const km = (a: { lat: number; lon: number }, b: { lat: number; lon: number }) => {
	const r = Math.PI / 180;
	const h =
		Math.sin(((b.lat - a.lat) * r) / 2) ** 2 +
		Math.cos(a.lat * r) * Math.cos(b.lat * r) * Math.sin(((b.lon - a.lon) * r) / 2) ** 2;
	return 2 * 6371 * Math.asin(Math.sqrt(h));
};

// The traverse runs west to east through every benchmark, each leg bowed gently north over the water.
const chain = [...marks].sort((a, b) => a.pos![0] - b.pos![0]);
const legs = chain.slice(1).map((b, i) => {
	const a = chain[i];
	const [x1, y1] = a.pos!;
	const [x2, y2] = b.pos!;
	const len = Math.hypot(x2 - x1, y2 - y1);
	const cx = (x1 + x2) / 2 + ((y2 - y1) / (len || 1)) * len * 0.16;
	const cy = (y1 + y2) / 2 - ((x2 - x1) / (len || 1)) * len * 0.16;
	const dist = a.geo && b.geo ? Math.round(km(a.geo, b.geo) / 10) * 10 : null;
	return { d: `M${x1} ${y1}Q${cx.toFixed(1)} ${cy.toFixed(1)} ${x2} ${y2}`, mid: [(x1 + 2 * cx + x2) / 4, (y1 + 2 * cy + y2) / 4], dist };
});
const traverse = legs.map((l) => l.d).join("");

// The map fills a rounded sheet edge to edge, like the site's photo tiles.
const VB = { x: 0, y: 0, w: MAP.width, h: MAP.height };
const pct = ([x, y]: number[]) => `left:${(((x - VB.x) / VB.w) * 100).toFixed(2)}%;top:${(((y - VB.y) / VB.h) * 100).toFixed(2)}%`;
const directions = (o: Office) =>
	`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${o.address ?? ""} ${o.city}`.trim())}`;
---

<section class="section footprint" id={v.anchor_id || undefined}>
	<div class="wrap">
		<Eyebrow label={v.label} />
		<div class="sec-head">
			<h2 class="disp h-lg" data-reveal>
				{v.headline}
				{v.highlight && <span class="accent"> {v.highlight}</span>}
			</h2>
			{v.intro && (
				<p class="lead" data-reveal>
					{v.intro}
				</p>
			)}
		</div>
		<div class="fp">
			<figure class="fp__map" data-map data-reveal>
				<svg
					viewBox={`${VB.x} ${VB.y} ${VB.w} ${VB.h}`}
					role="img"
					aria-label={`Map of the Gulf coast showing ${offices.map((o) => o.city).join(", ")}`}
				>
					<defs>
						<mask id="fp-reveal" maskUnits="userSpaceOnUse" x="0" y="0" width={MAP.width} height={MAP.height}>
							<path d={traverse} fill="none" stroke="#fff" stroke-width="8" pathLength="1" data-arc></path>
						</mask>
					</defs>
					<rect width={MAP.width} height={MAP.height} fill="#f4efe6"></rect>
					<path d={MAP.neighbours} fill="#ece6db"></path>
					<path d={MAP.saudi} fill="#e4dccd"></path>
					<path d={MAP.uae} fill="#7a1418" fill-opacity=".1"></path>
					<path d={MAP.borders} fill="none" stroke="#4a4039" stroke-opacity=".45" stroke-width=".9" stroke-dasharray="4 4"></path>
					<path d={MAP.saudi + MAP.uae + MAP.neighbours} fill="none" stroke="#4a4039" stroke-opacity=".55" stroke-width="1" stroke-linejoin="round"></path>
					<path d={MAP.uae} fill="none" stroke="#7a1418" stroke-opacity=".7" stroke-width="1.4" stroke-linejoin="round"></path>
					{
						MAP.labels.map((l) => (
							<text x={l.at[0]} y={l.at[1]} text-anchor="middle" class:list={["fp__geo", `fp__geo--${l.kind}`]}>
								{l.text}
							</text>
						))
					}
					<path d={traverse} fill="none" stroke="#7a1418" stroke-width="2" stroke-linecap="round" stroke-dasharray="1 7" mask="url(#fp-reveal)"></path>
					{
						marks.map((m) => (
							<g class:list={["fp__pin", { "fp__pin--hub": m === hub }]} data-office-mark={m.i}>
								{m === hub && <circle class="fp__pulse" cx={m.pos![0]} cy={m.pos![1]} r="14"></circle>}
								<circle cx={m.pos![0]} cy={m.pos![1]} r={m === hub ? 11 : 8} fill="#7a1418" stroke="#f4efe6" stroke-width="3"></circle>
							</g>
						))
					}
				</svg>
				{
					marks.map((m) => (
						<div class:list={["fp__label", `fp__label--${m.place}`, { "is-hub": m === hub }]} style={pct(m.pos!)} data-office-label={m.i}>
							{m.city}
							{m === hub && <span class="fp__hq">HQ</span>}
						</div>
					))
				}
				{
					legs
						.filter((l) => l.dist && l.dist >= 200)
						.map((l) => (
							<span class="fp__dist" style={pct(l.mid)}>
								≈ {l.dist} km
							</span>
						))
				}
			</figure>

			<ol class="fp__offices">
				{marks.map((m) => (
					<li class="fp__office" data-office={m.i} tabindex="0" data-reveal>
						<div class="fp__office-head">
							<span class="fp__office-no">{String(m.i + 1).padStart(2, "0")}</span>
							<h3 class="fp__office-city">{m.city}</h3>
							{m === hub && <span class="fp__hq">HQ</span>}
							{m.country && <span class="fp__office-country">{m.country}</span>}
						</div>
						{m.address && <address>{m.address}</address>}
						<span class="fp__links">
							{m.address && (
								<a href={directions(m)} target="_blank" rel="noopener">
									Directions <span aria-hidden="true">↗</span>
								</a>
							)}
							{m.phone && <a href={`tel:${m.phone.replace(/\s/g, "")}`}>{m.phone}</a>}
						</span>
					</li>
				))}
			</ol>
		</div>
	</div>
</section>

<script>
	// Hovering or focusing an office card picks out its pin on the map.
	for (const root of document.querySelectorAll<HTMLElement>(".footprint")) {
		const rows = [...root.querySelectorAll<HTMLElement>("[data-office]")];
		const targets = [...root.querySelectorAll<Element>("[data-office-mark], [data-office-label]")];
		const set = (i: string | null) => {
			root.classList.toggle("has-active", i !== null);
			for (const t of targets) {
				const own = t.getAttribute("data-office-mark") ?? t.getAttribute("data-office-label");
				t.classList.toggle("is-active", own === i);
			}
		};
		for (const r of rows) {
			r.addEventListener("mouseenter", () => set(r.dataset.office ?? null));
			r.addEventListener("focus", () => set(r.dataset.office ?? null));
			r.addEventListener("mouseleave", () => set(null));
			r.addEventListener("blur", () => set(null));
		}
	}
</script>

<style>
	.fp {
		display: grid;
		grid-template-columns: minmax(0, 1fr) clamp(300px, 28vw, 400px);
		gap: 12px;
		align-items: stretch;
	}

	/* ---------- map sheet ---------- */
	.fp__map {
		position: relative;
		align-self: start;
		overflow: hidden;
		aspect-ratio: 980 / 700;
		border-radius: var(--r-xl);
		background: var(--paper-2);
	}
	.fp__map svg {
		width: 100%;
		height: 100%;
	}
	.fp__geo {
		font-family: var(--font-body);
		fill: var(--ink-muted);
		fill-opacity: 0.7;
	}
	.fp__geo--country {
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 0.28em;
		text-transform: uppercase;
	}
	.fp__geo--minor {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}
	.fp__geo--sea {
		font-size: 15px;
		font-style: italic;
	}
	.fp__pin {
		transition: opacity 0.3s var(--ease);
	}
	.fp__pulse {
		fill: #7a1418;
		opacity: 0.25;
		transform-box: fill-box;
		transform-origin: center;
		animation: fp-pulse 2.4s var(--ease) infinite;
	}
	@keyframes fp-pulse {
		from {
			transform: scale(0.8);
			opacity: 0.35;
		}
		to {
			transform: scale(2.4);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.fp__pulse {
			animation: none;
		}
	}

	/* pin labels: pill chips, like the industry tiles */
	.fp__label {
		position: absolute;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		padding: 7px 14px;
		border-radius: 999px;
		background: var(--paper-2);
		box-shadow: 0 6px 18px rgba(20, 16, 16, 0.12);
		font-size: 14px;
		font-weight: 700;
		color: var(--ink);
		white-space: nowrap;
		pointer-events: none;
		transition: opacity 0.3s var(--ease);
	}
	.fp__label--e {
		transform: translate(20px, -50%);
	}
	.fp__label--w {
		transform: translate(calc(-100% - 20px), -50%);
	}
	.fp__label--n {
		transform: translate(-30%, calc(-100% - 18px));
	}
	.fp__label--s {
		transform: translate(-70%, 22px);
	}
	.fp__label.is-hub {
		background: var(--ink);
		color: var(--paper);
	}
	.fp__dist {
		position: absolute;
		transform: translate(-50%, -50%);
		padding: 4px 10px;
		border-radius: 999px;
		background: rgba(244, 239, 230, 0.85);
		font-size: 12px;
		font-weight: 600;
		color: var(--maroon);
		white-space: nowrap;
	}
	.footprint.has-active :is(.fp__pin, .fp__label):not(.is-active) {
		opacity: 0.3;
	}

	.fp__hq {
		padding: 2px 8px;
		border-radius: 999px;
		background: var(--maroon);
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: #fff;
	}

	/* ---------- office cards ---------- */
	.fp__offices {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.fp__office {
		display: flex;
		flex-direction: column;
		gap: 6px;
		flex: 1;
		padding: 20px 22px;
		border-radius: var(--r-lg);
		background: var(--paper-2);
		outline: none;
		transition:
			background 0.3s var(--ease),
			transform 0.3s var(--ease);
	}
	.fp__office:hover,
	.fp__office:focus-visible {
		background: #fff;
		transform: translateY(-2px);
	}
	.fp__office:focus-visible {
		box-shadow: 0 0 0 2px var(--maroon);
	}
	.fp__office-head {
		display: flex;
		align-items: center;
		gap: 10px;
	}
	.fp__office-no {
		font-size: 12px;
		font-weight: 700;
		color: var(--maroon);
	}
	.fp__office-city {
		margin: 0;
		font-family: var(--font-display);
		font-size: 20px;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.2;
	}
	.fp__office-country {
		margin-inline-start: auto;
		font-size: 12px;
		color: var(--ink-muted);
	}
	.fp__office address {
		font-style: normal;
		font-size: 14px;
		line-height: 1.5;
		color: var(--ink-soft);
	}
	.fp__links {
		display: flex;
		flex-wrap: wrap;
		gap: 2px 16px;
		font-size: 14px;
		font-weight: 600;
	}
	.fp__links a {
		color: var(--maroon);
	}
	.fp__links a:hover {
		color: var(--ink);
	}

	@media (max-width: 1024px) {
		.fp {
			grid-template-columns: minmax(0, 1fr);
		}
		.fp__offices {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 640px) {
		.fp__geo,
		.fp__dist {
			display: none;
		}
		.fp__label {
			padding: 4px 9px;
			font-size: 11px;
			gap: 5px;
		}
		.fp__label .fp__hq {
			display: none;
		}
		.fp__label--n {
			transform: translate(-85%, calc(-100% - 12px));
		}
		.fp__office-head {
			flex-wrap: wrap;
		}
		.fp__office-city {
			white-space: nowrap;
		}
		.fp__office-country {
			flex-basis: 100%;
			margin-inline-start: 0;
		}
		.fp__offices {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
