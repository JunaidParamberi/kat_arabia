---
interface Props {
	size?: number;
	tagline?: boolean;
	idSuffix?: string;
	variant?: "dark" | "light";
}
const { size = 34, variant = "dark" } = Astro.props;
// 1948x1320 source → preserve aspect ratio at the requested mark height.
const width = Math.round((size * 1948) / 1320);
const src = variant === "light" ? "/images/kat-arabia-logo-white.png" : "/images/kat-arabia-logo.png";
---

<span class="logo">
	<img
		class="logo__img"
		src={src}
		width={width}
		height={size}
		alt="KAT Arabia General Contracting"
	/>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
	}
	.logo__img {
		display: block;
	}
</style>
