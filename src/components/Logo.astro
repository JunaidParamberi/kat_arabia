---
interface Props {
	size?: number;
	tagline?: boolean;
	idSuffix?: string;
}
const { size = 34, tagline = true, idSuffix = "h" } = Astro.props;
const maskId = `kat-mark-${idSuffix}`;
---

<span class="logo">
	<svg viewBox="546 0 855 855" width={size} height={size} aria-hidden="true">
		<defs>
			<mask id={maskId} maskUnits="userSpaceOnUse" x="500" y="-60" width="960" height="960">
				<rect x="500" y="-60" width="960" height="960" fill="#fff"></rect>
				<g stroke="#000" stroke-width="34">
					<line x1="926" y1="-20" x2="679" y2="710"></line>
					<line x1="1300" y1="182" x2="775" y2="435"></line>
					<line x1="962" y1="342" x2="1161" y2="830"></line>
				</g>
			</mask>
		</defs>
		<g mask={`url(#${maskId})`}>
			<rect
				x="-353"
				y="-353"
				width="706"
				height="706"
				rx="175"
				transform="translate(973 427) rotate(45)"
				fill="var(--logo-mark, #a3232a)"></rect>
		</g>
	</svg>
	<span class="logo__text">
		<span class="logo__name">KAT ARABIA</span>
		{tagline && <span class="logo__tag">GENERAL CONTRACTING</span>}
	</span>
</span>

<style>
	.logo {
		display: inline-flex;
		align-items: center;
		gap: 12px;
	}
	.logo__text {
		display: flex;
		flex-direction: column;
		gap: 3px;
	}
	.logo__name {
		font-family: var(--font-brand);
		font-weight: 600;
		font-size: 17px;
		letter-spacing: 0.02em;
		line-height: 1;
	}
	.logo__tag {
		font-family: var(--font-brand);
		font-weight: 500;
		font-size: 7.5px;
		letter-spacing: 0.42em;
		opacity: 0.75;
		line-height: 1;
	}
</style>
